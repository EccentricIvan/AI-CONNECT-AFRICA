<?xml version="1.0" encoding="utf-8"?>
<!--
  Class sync talks to the teacher's device at http://<its Wi-Fi address>:8765.
  Android has no way to allow plain HTTP for "local network addresses only"
  (domain entries are exact names, no ranges), so it is allowed generally.

  That is safe for sync because the protocol protects itself: every reply is
  encrypted with the class key and signed by the teacher's device, and every
  request is MAC'd (lib/collaboration/sync/class_crypto.dart). Anything the
  app fetches from the internet uses https:// URLs, which this does not change.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
